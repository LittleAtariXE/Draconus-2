#!name##ShellcodeExtractor
#!itemType##compiler
#!info##Compiles and extracts shellcode from a module.
#!compilerMCNAME##MinGW_Extract

{
    "NAME" : "ShellcodeExtractor",
    "SHELLCODE_EXTRACT" : {
        "COMPILER_CMD" : "cd {{__WORK_DIR_DOCKER}} && nasm -f bin {{__SRC_FILE_NAME}} -o {{__MODULE_NAME}}.o",
        "SCODE_EXTRACT" : "cd {{__WORK_DIR_DOCKER}} && objdump -D -b binary -mi386:x86-64 {{__MODULE_NAME}}.o > {{__MODULE_NAME}}_objdump.txt",
        "COMPILER_CLEAN" : [
            "cd {{__WORK_DIR_DOCKER}} && chmod 777 *"
        ]
    }
}