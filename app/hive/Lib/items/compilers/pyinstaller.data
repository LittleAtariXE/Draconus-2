#!name##PyInstaller
#!itemType##compiler
#!info##PyInstaller compiler. Compiles a Python file into a Windows x64 EXE.
#!compilerMCNAME##MinGW-x64
#!Var##PYI_EXE_SHOW##console##'console' - the executable runs as a console program. 'gui' - the executable's output is not displayed.##str
#!Var##PYI_ONE_FILE##True##Using the '--onefile' flag. Compiles the program into a single EXE file.##str


{% set __COMP_EXEC = "wine pyinstaller" %}

{% if PYI_EXEC_SHOW == "console" %}
    {% set __EXEC_SHOW = "--console" %}
{% else %}
    {% set __EXEC_SHOW = "--windowed" %}
{% endif %}

{% if PYI_ONE_FILE == True or PYI_ONE_FILE == 'True' %}
    {% set __ONE_FILE = "--onefile" %}
{% else %}
    {% set __ONE_FILE = "" %}
{% endif %}

{
    "WORKING_DIR" : "{{__WORK_DIR_DOCKER}}",
    "COMPILER_CMD" : [
        "cd {{__WORK_DIR_DOCKER}} && {{__COMP_EXEC}} {{__ONE_FILE}} {{__EXEC_SHOW}} --name={{__FINAL_OUTPUT_FNAME}} {{__SRC_FILE_NAME}}",
        "cd {{__WORK_DIR_DOCKER}}/dist && cp ./{{__FINAL_OUTPUT_FNAME}} {{__WORK_DIR_DOCKER}}",
        "cd {{__WORK_DIR_DOCKER}} && chmod 777 *",
        "cd {{__WORK_DIR_DOCKER}} && rm -R build/",
        "cd {{__WORK_DIR_DOCKER}} && rm -R dist/"
    ]
}