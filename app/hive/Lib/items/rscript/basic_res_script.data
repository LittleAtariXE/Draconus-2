#!name##BasicRes
#!itemType##rscript
#!info##Resource Script. Script file '.rc'. Generates lots of random information about the executable. You can set your own.
#!hiveType##RcExe
#!foodAdd##CompanyName##BRE_cname
#!foodAdd##AppDescription##BRE_appd
#!foodAdd##AppName##BRE_appn
#!Var##BRE_company##_RANDOM##Company Name. '_RANDOM' - get random name from food database##str
#!Var##BRE_appdesc##_RANDOM##Application description. '_RANDOM' - get random name from food database##str
#!Var##BRE_appname##_RANDOM##Application name. '_RANDOM' - get random name from food database##str


{% set _BRE_company = randTOOL.randomStr(BRE_cname, BRE_company) %}
{% set _BRE_appdesc = randTOOL.randomStr(BRE_appd, BRE_appdesc) %}
{% set _BRE_fversion = randTOOL.randomVersion(4) %}
{% set _BRE_pversion = randTOOL.randomVersion(4, separator=".") %}
{% set _BRE_appname = randTOOL.randomStr(BRE_appd, BRE_appname) %}

1 VERSIONINFO
FILEVERSION {{_BRE_fversion}}
PRODUCTVERSION {{_BRE_fversion}}
FILEOS 0x4                // VOS__WINDOWS32
FILETYPE 0x1              // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "{{_BRE_company}}"
            VALUE "FileDescription",  "{{_BRE_appname}}-{{_BRE_appdesc}}"
            VALUE "FileVersion",      "{{_BRE_pversion}}"
            VALUE "InternalName",     "{{_BRE_appname}}-{{_BRE_pversion}}"
            VALUE "LegalCopyright",   "Copyright 2025 {{_BRE_company}}"
            VALUE "OriginalFilename", "{{_BRE_appname}}.exe"
            VALUE "ProductName",      "{{_BRE_appname}}"
            VALUE "ProductVersion",   "{{_BRE_pversion}}"
            VALUE "Comments",         "Built with love and coffee."
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0 // US English (Unicode)
    END
END