#!name##BasicRes
#!itemType##rscript
#!info##Resource Script. Script file '.rc'. Generates lots of random information about the executable. You can set your own.
#!Var##RSCR_test##AlaMaKota##Variables from resources script##str
#!hiveType##RcExe

1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,3,4
FILEOS 0x4                // VOS__WINDOWS32
FILETYPE 0x1              // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Acme Labs, Ltd."
            VALUE "FileDescription",  "MyApp — sample application"
            VALUE "FileVersion",      "1.2.3.4"
            VALUE "InternalName",     "MyApp-1.2.3.4"
            VALUE "LegalCopyright",   "Copyright 2025 Acme Labs, Ltd."
            VALUE "OriginalFilename", "MyApp.exe"
            VALUE "ProductName",      "MyApp"
            VALUE "ProductVersion",   "1.2.3.4"
            VALUE "Comments",         "Built with love and coffee."
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0 // US English (Unicode)
    END
END