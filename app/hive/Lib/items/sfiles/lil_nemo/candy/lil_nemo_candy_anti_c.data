{% set _K32DLL = ["KERNEL32.dll", "Kernel32.dll", "KERNEL32.DLL", "kernel32.dll"] %}

{% set _ = _CANTI_SHADOW.randomizeShadow(5, 47, 3) %}

#include "lil_nemo_candy_anti.h"

#define LNCA_MORPH_KEY_PART 0

uint16_t* lil_nemo_candy_anti_get_key(void) {
    uint16_t anti_key[] = {
        {{_CANTI_SHADOW.showKeyHex() }}
    };
    int kid = 0;
    while (anti_key[kid] != 0) {
        kid++;
    }
    uint16_t *rkey = malloc((kid + 1) * sizeof(uint16_t));
    memset(rkey, 0, (kid + 1) * sizeof(uint16_t));
    memcpy(rkey, anti_key, kid * sizeof(uint16_t));
    return rkey;
}

