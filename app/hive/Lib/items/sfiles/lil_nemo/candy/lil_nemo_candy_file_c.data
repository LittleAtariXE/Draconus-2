#!name##LilNemo_CandyFile_C
#!itemType##sfile
#!info##LittleNemo Candy File C file.
#!lang##c
#!addNameComp##True
#!Var##LHK_fext##_NULL##File extensions to search for. Separate extensions with commas ",". Leaving this field empty will cause this criterion to be ignored by the filters.##str
#!Var##LHK_fname##_NULL##Names of target files to search for. Separate names with commas ",". Leaving this field empty will cause this criterion to be ignored by the filters.##str
#!Var##LHK_dname##_NULL##Names of directories to search. If any of the specified directories is not found starting from the search position, the search is terminated. Separate names with commas ",". Leaving this field empty will cause this criterion to be ignored by the filters.##str
#!Var##LHK_spath##c:\, d:\##Initial paths to the directories from which the search will begin. For example: ‘c:\’, ‘c:\documents’, etc. Separate extensions with commas ",".##str


{% set _NEMO_FILE_FEXT = _LNSHADOW.convertToList(LHK_fext, ",") %}
{% set _NEMO_FILE_FNAME = _LNSHADOW.convertToList(LHK_fname, ",") %}
{% set _NEMO_FILE_DNAME = _LNSHADOW.convertToList(LHK_dname, ",") %}
{% set _NEMO_FILE_SPATH = _LNSHADOW.convertToList(LHK_spath, ",") %}

#include "lil_nemo_candy_file.h"

#include <stdio.h>

static void fbfClearFileBag(pLIL_NEMO_FILE_BASIC fbag) {
    fbag->bag->clear(fbag->bag);
    if (fbag->file_ext != 0) {
        for (int i=0; i<fbag->file_ext_size; i++) {
            if (fbag->file_ext[i] != 0) {
                free(fbag->file_ext[i]);
            }
        }
        free(fbag->file_ext);
    }
    if (fbag->dir_name != 0) {
        for (int i=0; i<fbag->dir_name_size; i++) {
            if (fbag->dir_name[i] != 0) {
                free(fbag->dir_name[i]);
            }
        }
        free(fbag->dir_name);
    }
    if (fbag->file_name != 0) {
        for (int i=0; i<fbag->file_name_size; i++) {
            if (fbag->file_name[i] != 0) {
                free(fbag->file_name[i]);
            }
        }
        free(fbag->file_name);
    }
    if (fbag->start_path != 0) {
        for (int i=0; i<fbag->start_path_size; i++) {
            if (fbag->start_path[i] != 0) {
                free(fbag->start_path[i]);
            }
        }
        free(fbag->start_path);
    }
    free(fbag);
}



BYTE* fbLoadFile(char *fpath, DWORD *size_var) {
    FILE *tar_file = fopen(fpath, "rb");
    if (!tar_file) {
        return NULL;
    }
    fseek(tar_file, 0, SEEK_END);
    DWORD size = ftell(tar_file);
    fseek(tar_file, 0, SEEK_SET);

    BYTE *buff = malloc(size);
    fread(buff, 1, size, tar_file);
    fclose(tar_file);
    *size_var = size;
    return buff;
}

void fbWalkDir(char *start_path, pLIL_NEMO_FILE_BASIC fbag, NNType_NemoDirProcFunc func_dir, NNType_NemoFileProcFile process_file) {
    char *dir_path = malloc(NEMO_BFILE_PATH_BUFF_SIZE);
    memset(dir_path, 0, NEMO_BFILE_PATH_BUFF_SIZE);
    snprintf(dir_path, NEMO_BFILE_PATH_BUFF_SIZE, "%s\\*", start_path);
    WIN32_FIND_DATAA find_data;
    HANDLE fhandle = fbag->firstFile(dir_path, &find_data);
    if (fhandle == INVALID_HANDLE_VALUE) {
        goto L_CLEAR;
    }
    char *full_path = malloc(NEMO_BFILE_PATH_BUFF_SIZE);
    memset(full_path, 0, NEMO_BFILE_PATH_BUFF_SIZE);
    do {
        if (strcmp(find_data.cFileName, ".") == 0 || strcmp(find_data.cFileName, "..") == 0) {
            continue;
        }
        memset(full_path, 0, NEMO_BFILE_PATH_BUFF_SIZE);
        snprintf(full_path, NEMO_BFILE_PATH_BUFF_SIZE, "%s\\%s", start_path, find_data.cFileName);
        if (find_data.dwFileAttributes == FILE_ATTRIBUTE_DIRECTORY) {
            if (func_dir(full_path, find_data.cFileName, fbag) == 1) {
                fbWalkDir(full_path, fbag, func_dir, process_file);
            }
            continue;
        }    
        else {
            process_file(full_path, find_data.cFileName, fbag);
        }
            
    } while (fbag->nextFile(fhandle, &find_data) != 0);

    free(full_path);

    L_CLEAR:
        free(dir_path);
}



void fbfDecodeText(uint16_t *src_data, uint16_t src_size, char *dest_buff, pLIL_NEMO_BAG bag) {
    int data_size = src_size / sizeof(uint16_t);
    memset(dest_buff, 0, data_size);
    int key_id = 0;
    for (int i=0; i<data_size; i++) {
        if (bag->str_key[key_id] == 0) {
            key_id = 0;
        }
        dest_buff[i] = src_data[i] - bag->str_key[key_id];
        key_id++;
    }
}

void fbsGetFileExt(pLIL_NEMO_FILE_BASIC fbag) {
    {{_LNSHADOW.encodeList(_NEMO_FILE_FEXT)}}

    if (data_size == 0) {
        fbag->file_ext = 0;
        fbag->file_ext_size = 0;
        return;
    }

    char **file_ext = malloc(data_size * sizeof(char*));
    memset(file_ext, 0, data_size * sizeof(char*));
    for (int i=0; i<data_size; i++) {
        char *single_ext = malloc(all_size[i] * sizeof(char));
        memset(single_ext, 0, all_size[i] * sizeof(char));
        fbfDecodeText(all_addr[i], all_size[i], single_ext, fbag->bag);
        file_ext[i] = single_ext;
    }
    fbag->file_ext_size = data_size;
    fbag->file_ext = file_ext;

}

