int fbCheckFileExt(const char* file_ext, pLIL_NEMO_FILE_BASIC fbag) {
    if (fbag->file_ext == 0) {
        return 1;
    }
    int result = 0;
    for (int i=0; i<fbag->file_ext_size; i++) {
        result = strcmp(file_ext, fbag->file_ext[i]);
        if (result == 0) {
            return 1;
        }
    }
    return 0;
}

int fbCheckDirName(char *dir_name, pLIL_NEMO_FILE_BASIC fbag) {
    if (fbag->dir_name == 0) {
        return 1;
    }
    int result = 0;
    for (int i=0; i<fbag->dir_name_size; i++) {
        result = strcmp(dir_name, fbag->dir_name[i]);
        if (result == 0) {
            return 1;
        }
    }
    return 0;
}

int fbCheckFileName(char *file_name, pLIL_NEMO_FILE_BASIC fbag) {
    if (fbag->file_name == 0) {
        return 1;
    }
    char *fname = strdup(file_name);
    char *fext = strrchr(fname, '.');
    if (fext != NULL) {
        *fext = '\0';
    }
    int result;
    for (int i=0; i<fbag->file_name_size; i++) {
        result = strcmp(fname, fbag->file_name[i]);
        if (result == 0) {
            free(fname);
            return 1;
        }
    }
    free(fname);
    return 0;
}

pLIL_NEMO_FILE_BASIC fbMakeFileBag(uint16_t *ekey, uint16_t *str_key) {
    pLIL_NEMO_BAG bag = lil_nemo_bag_prepareNemo(ekey, str_key, 0, NEMO_BFILE_BALLOC_SIZE, 0, NEMO_BFILE_BAG_BUFF_SIZE, 0, NEMO_BFILE_BAG_BUFF_SIZE, 0, NEMO_BFILE_BAG_BUFF_SIZE);
    pLIL_NEMO_FILE_BASIC fbag = malloc(sizeof(LIL_NEMO_FILE_BASIC));
    memset(fbag, 0, sizeof(LIL_NEMO_FILE_BASIC));
    fbag->bag = bag;
    fbag->clear = fbfClearFileBag;
    void *k32 = bag->find_dll(bag->raw_k32, bag);
    if (k32 == 0) {
        goto L_RETURN_NULL;
    }
    fbag->firstFile = bag->get_func2(lil_nemo_food_FindFirstFileA, k32, bag);
    fbag->nextFile = bag->get_func2(lil_nemo_food_FindNextFileA, k32, bag);
    void *shlw = bag->load_ldr_dll(lil_nemo_food_Shlwapi_dll, bag);
    if (shlw == 0) {
        goto L_RETURN_NULL;
    }
    fbag->findExt = bag->get_func2(lil_nemo_food_PathFindExtensionA, shlw, bag);
    fbsGetFileExt(fbag);
    fbsGetFileName(fbag);
    fbsGetDirName(fbag);
    fbsGetStartPath(fbag);
    return fbag;

    L_RETURN_NULL:
        fbfClearFileBag(fbag);
        return 0;
}