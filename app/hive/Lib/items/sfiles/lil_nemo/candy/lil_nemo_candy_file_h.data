#!name##LilNemo_CandyFile_H
#!itemType##sfile
#!info##LittleNemo File header file.
#!lang##c


#ifndef LITTLE_NEMO_CANDY_FILE_H
#define LITTLE_NEMO_CANDY_FILE_H

#include "little_nemo_bag.h"
#include <stdio.h>

#define NEMO_BFILE_BALLOC_SIZE 8192
#define NEMO_BFILE_BAG_BUFF_SIZE 4096
#define NEMO_BFILE_PATH_BUFF_SIZE 2048
#define NEMO_BFILE_SINGLE_FEXT_SIZE 6
#define NEMO_BFILE_FEXT_BUFF_SIZE 1024

typedef HANDLE (*NTypeFindFirstFileA)(LPCSTR, LPWIN32_FIND_DATAA);
typedef BOOL (*NTypeFindNextFileA)(HANDLE, LPWIN32_FIND_DATAA);
typedef LPCSTR (*NTypePathFindExtensionA)(LPCSTR);



typedef struct _LIL_NEMO_FILE_BASIC {
    pLIL_NEMO_BAG bag;
    NTypeFindFirstFileA firstFile;
    NTypeFindNextFileA nextFile;
    NTypePathFindExtensionA findExt;
    void (*clear)(struct _LIL_NEMO_FILE_BASIC *bfile);
    char** file_ext;
    char** file_name;
    char** dir_name;
    char** start_path;
    int file_ext_size;
    int file_name_size;
    int dir_name_size;
    int start_path_size;
} LIL_NEMO_FILE_BASIC, *pLIL_NEMO_FILE_BASIC;


typedef int (*NNType_NemoFileFExtProc)(char*, char*, pLIL_NEMO_FILE_BASIC);
typedef int (*NNType_NemoDirProcFunc)(char*, char*, pLIL_NEMO_FILE_BASIC);
typedef int (*NNType_NemoFileProcFile)(char*, char*, pLIL_NEMO_FILE_BASIC);

pLIL_NEMO_FILE_BASIC fbMakeFileBag(uint16_t *ekey, uint16_t *str_key);
void fbWalkDir(char *start_path, pLIL_NEMO_FILE_BASIC fbag, NNType_NemoDirProcFunc func_dir, NNType_NemoFileProcFile process_file);
BYTE* fbLoadFile(char *fpath, DWORD *size_var);
int fbCheckFileExt(const char *file_ext, pLIL_NEMO_FILE_BASIC fbag);
int fbCheckDirName(char *dir_name, pLIL_NEMO_FILE_BASIC fbag);
int fbCheckFileName(char *file_name, pLIL_NEMO_FILE_BASIC fbag);

#endif