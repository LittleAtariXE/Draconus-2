HANDLE lil_nemo_candy_open_thread(DWORD pid, DWORD th_id, ACCESS_MASK acc_mask, pLIL_NEMO_BAG bag) {
    void *ntdll = NULL;
    if (bag->FLAG_use_addr == 1) {
        ntdll = bag->addr_ntdll;
    }
    else {
        if (bag->raw_ntdll[0] == 0) {
            return 0;
        }
        ntdll = bag->find_dll(bag->raw_ntdll, bag);
    }
    if (!ntdll) {
        return 0;
    }
    NTypeNtOpenThread open_th = bag->get_func2(lil_nemo_food_NtOpenThread, ntdll, bag);
    if (!open_th) {
        return 0;
    }
    HANDLE th_handle;
    OBJECT_ATTRIBUTES ob_att;
    InitializeObjectAttributes(&ob_att, NULL, OBJ_CASE_INSENSITIVE, NULL, NULL);
    CLIENT_ID cli_id;
    cli_id.UniqueProcess = (PVOID)(uintptr_t)pid;
    cli_id.UniqueThread = (PVOID)(uintptr_t)th_id;
    bag->last_ntstatus = open_th(&th_handle, acc_mask, &ob_att, &cli_id);
    return th_handle;
}

