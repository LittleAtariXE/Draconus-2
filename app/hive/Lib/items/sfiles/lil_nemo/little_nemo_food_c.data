{% set _K32DLL = ["KERNEL32.dll", "Kernel32.dll", "KERNEL32.DLL", "kernel32.dll"] %}
{% set _NTDLL = ["ntdll.dll"] %}


#include "little_nemo_food.h"



static void lil_nemo_food_clear(pLIL_NEMO_FOOD_LIST flist) {
    free(flist->size);
    free(flist);
}

pLIL_NEMO_FOOD_LIST lil_nemo_food_make(void) {
    pLIL_NEMO_FOOD_LIST flist = malloc(sizeof(LIL_NEMO_FOOD_LIST));
    memset(flist, 0, sizeof(LIL_NEMO_FOOD_LIST));
    flist->clear = lil_nemo_food_clear;
    flist->list_ptr = NULL;
    flist->size = NULL;
    flist->target = NULL;
    flist->target_size = 0;
    return flist;
}

static void lil_nemo_food_text_clear(pLIL_NEMO_FOOD_TEXT ftext) {
    free(ftext->text);
    free(ftext);
}

pLIL_NEMO_FOOD_TEXT lil_nemo_food_text_make(void) {
    pLIL_NEMO_FOOD_TEXT ftext = malloc(sizeof(LIL_NEMO_FOOD_TEXT));
    memset(ftext, 0, sizeof(LIL_NEMO_FOOD_TEXT));
    ftext->size = 0;
    ftext->text = NULL;
    ftext->clear = lil_nemo_food_text_clear;
    return ftext;
}

