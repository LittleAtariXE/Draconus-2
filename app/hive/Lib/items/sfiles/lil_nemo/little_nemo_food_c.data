pLIL_NEMO_FOOD_LIST lil_nemo_food_kernel32(uint16_t **buff, uint16_t buff_size) {
{{ _LNSHADOW.shadowList(_K32DLL) }}

    
    pLIL_NEMO_FOOD_LIST flist = lil_nemo_food_make();
    flist->size = malloc(sizeof(all_size));
    memset(flist->size, 0, sizeof(all_size));
    memcpy(flist->size, all_size, sizeof(all_size));
    memset(buff, 0, buff_size * sizeof(uint16_t*));
    memcpy(buff, all_addr, sizeof(all_addr));
    flist->list_ptr = buff;
    return flist;
}



pLIL_NEMO_FOOD_LIST lil_nemo_food_ntdll(uint16_t **buff, uint16_t buff_size) {
{{ _LNSHADOW.shadowList(_NTDLL) }}

    pLIL_NEMO_FOOD_LIST flist = lil_nemo_food_make();
    flist->size = malloc(sizeof(all_size));
    memset(flist->size, 0, sizeof(all_size));
    memcpy(flist->size, all_size, sizeof(all_size));
    memset(buff, 0, buff_size * sizeof(uint16_t*));
    memcpy(buff, all_addr, sizeof(all_addr));
    flist->list_ptr = buff;
    return flist;
}

