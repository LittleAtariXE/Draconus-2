NTSTATUS robbo_wapi_NtCreateFile(PHANDLE file_handle, ACCESS_MASK acc_mask, POBJECT_ATTRIBUTES obj_attr, PIO_STATUS_BLOCK io_status_block, PLARGE_INTEGER alloc_size, ULONG file_attr, ULONG share_access, ULONG create_dispotion, ULONG create_options, PVOID ea_buffer, ULONG ea_length) {
    RtypeNtCreateFile cr_file = robbo_get_function(raw_name_NtCreateFile, robbo_addr_ntdll);
    return cr_file(file_handle, acc_mask, obj_attr, io_status_block, alloc_size, file_attr, share_access, create_dispotion, create_options, ea_buffer, ea_length);
