// ----------------------------------- INIT FUNCTIONS --------------------------------------------------

void robbo_init_test(void) {
    printf("ROBBO INIT TEST\n");
}


void robbo_initialize(void) {
    ChipDaleInit();
    robbo_addr_kernel32 = ChipDaleADDR_kernel32();
    robbo_addr_ntdll = ChipDaleADDR_ntdll();
    robbo_faddr_MultiByteToWideChar = robbo_get_function(raw_name_MultiByteToWideChar, robbo_addr_kernel32);
    robbo_faddr_RtlInitUnicodeString = robbo_get_function(raw_name_RtlInitUnicodeString, robbo_addr_ntdll);
    robbo_faddr_NtClose = robbo_get_function(raw_name_NtClose, robbo_addr_ntdll);
}

