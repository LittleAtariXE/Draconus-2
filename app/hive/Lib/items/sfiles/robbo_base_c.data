#include "robbo_base.h"
#include <stdio.h>
#include <string.h>

#define ROBBO_DECODE_NAME_BUFF_SIZE 256

// LIB import
extern void* ChipDaleInit(void);
extern void* ChipDaleADDR_kernel32(void);
extern void* ChipDaleADDR_ntdll(void);
extern void* ChipFindTreasureSingle(char*);
extern char* DaleShow(char*);
extern void* ChipGetFunc(char*, void*);

// ---------------------------- INIT FUNCTIONS --------------------------------------

// variables
void *robbo_addr_kernel32 = NULL;
void *robbo_addr_ntdll = NULL;


// functions





// ------------------------- DECODE FUNCTIONS ---------------------------------------------------

// static variables
static char robbo_var_separator[] = "{{_ROBBO.ShowPower()}}";
static char robbo_var_key[] = {
    {{_ROBBO.ShowKey()}}
};
static char robbo_var_buff_name[ROBBO_DECODE_NAME_BUFF_SIZE];

// functions

char* robbo_decode(int encode_table[]) {
    memset(robbo_var_buff_name, 0, ROBBO_DECODE_NAME_BUFF_SIZE);
    int key_index = 0;
    int tab_index = 0;
    int temp;

    while (encode_table[tab_index] != 0) {
        if (key_index == sizeof(robbo_var_key)) {
            key_index = 0;
        }
        temp = encode_table[tab_index] - (robbo_var_key[key_index] * (sizeof(robbo_var_separator) -1));
        robbo_var_buff_name[tab_index] = (char)temp;
        key_index++;
        tab_index++;
    }
    return robbo_var_buff_name;
}

void robbo_decode2(int encode_table[], char buff[], int buff_size) {
    memset(buff, 0, buff_size);
    int key_index = 0;
    int tab_index = 0;
    int temp;

    while (encode_table[tab_index] != 0) {
        if (key_index == sizeof(robbo_var_key)) {
            key_index = 0;
        }
        temp = encode_table[tab_index] - (robbo_var_key[key_index] * (sizeof(robbo_var_separator) -1));
        buff[tab_index] = (char)temp;
        key_index++;
        tab_index++;
    }
}

// ------------------------- FIND FUNCTIONS ----------------------------------------------

void* robbo_get_function_raw(char *func_name, void *dll_address) {
    return ChipGetFunc(func_name, dll_address);
}

void* robbo_get_function(int encoded_table[], void *dll_address) {
    char *buff = robbo_decode(encoded_table);
    return ChipGetFunc(buff, dll_address);
}

// ----------------------- LOAD FUNCTIONS -----------------------------------------
typedef HMODULE (*RtypeLoadLibraryA)(LPCSTR);
typedef INT (*RtypeMultiByteToWideChar)(UINT, DWORD, const char*, int, LPWSTR, int);
typedef NTSTATUS (*RtypeLdrLoadDll)(PWSTR, PULONG, PUNICODE_STRING, HMODULE*);

// static var
static int raw_name_LoadLibraryA[] = {
    {{_ROBBO.EncodeStr("LoadLibraryA")}}
};
static int raw_name_MultiByteToWideChar[] = {
    {{_ROBBO.EncodeStr("MultiByteToWideChar")}}
};
static RtypeMultiByteToWideChar robbo_f_addr_MultiByteToWideChar = NULL;
static UINT raw_const_CODE_PAGE_UTF_8 = 65001;
static int raw_name_LdrLoadDll[] = {
    {{_ROBBO.EncodeStr("LdrLoadDll")}}
};
static WCHAR robbo_buff_dll_name[ROBBO_DECODE_NAME_BUFF_SIZE];


HMODULE robbo_load_dll_raw_lla(LPCSTR dll_name) {
    char *buff = robbo_decode(raw_name_LoadLibraryA);
    RtypeLoadLibraryA lla = ChipGetFunc(buff, robbo_addr_kernel32);
    return lla(dll_name);
}

HMODULE robbo_load_dll_lla(int encoded_name[]) {
    char *buff = robbo_decode(raw_name_LoadLibraryA);
    RtypeLoadLibraryA lla = ChipGetFunc(buff, robbo_addr_kernel32);
    char *buff2 = robbo_decode(encoded_name);
    return lla(buff2);
}

INT robbo_convert_utf16(const char* src_str, LPWSTR buffer, int buff_size) {
    return robbo_f_addr_MultiByteToWideChar(raw_const_CODE_PAGE_UTF_8, 0, src_str, -1, buffer, buff_size);
}

UNICODE_STRING robbo_build_unicode_struct(char text[], WCHAR buff[], int buff_size) {
    int size = robbo_convert_utf16(text, buff, buff_size);
    UNICODE_STRING dInfo;
    dInfo.Buffer = buff;
    dInfo.Length = size;
    dInfo.MaximumLength = size + sizeof(WCHAR);
    return dInfo;
}

HMODULE robbo_load_dll_raw_ldr_ldll(char dll_name[]) {
    HMODULE dll_handle = NULL;
    WCHAR buff[256];
    robbo_convert_utf16(dll_name, buff, 256);
    UNICODE_STRING dll_info;
    robbo_wapi_RtlInitUnicodeString(&dll_info, buff);
    RtypeLdrLoadDll lld = robbo_get_function(raw_name_LdrLoadDll, robbo_addr_ntdll);
    NTSTATUS result = lld(0, 0, &dll_info, &dll_handle);
    printf("NTSTATUS: %x\n", result);
    return dll_handle;
}

HMODULE robbo_load_dll_ldr(int encoded_name[]) {
    memset(robbo_buff_dll_name, 0, sizeof(robbo_buff_dll_name));
    RtypeLdrLoadDll lld = robbo_get_function(raw_name_LdrLoadDll, robbo_addr_ntdll);
    char *buff = robbo_decode(encoded_name);
    WCHAR wbuff[256];
    robbo_convert_utf16(buff, wbuff, 256);
    UNICODE_STRING dll_info;
    robbo_wapi_RtlInitUnicodeString(&dll_info, wbuff);
    HMODULE dll_handle;
    NTSTATUS result = lld(0, 0, &dll_info, &dll_handle);
    return dll_handle;
}



