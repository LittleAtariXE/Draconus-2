NTSTATUS robbo_wapi_NtOpenProcess(PHANDLE proc_handle, ACCESS_MASK access_mask, POBJECT_ATTRIBUTES objAttr, PCLIENT_ID client_id) {
    RtypeNtOpenProcess oProc = robbo_get_function(raw_name_NtOpenProcess, robbo_addr_ntdll);
    return oProc(proc_handle, access_mask, objAttr, client_id);
}

NTSTATUS robbo_wapi_NtAllocateVirtualMemory(HANDLE proc_handle, PVOID mem_addr, ULONG_PTR zero_bits, PSIZE_T mem_size, ULONG allocation_type, ULONG protect_flag) {
    RtypeNtAllocateVirtualMemory alloc_mem = robbo_get_function(raw_name_NtAllocateVirtualMemory, robbo_addr_ntdll);
    return alloc_mem(proc_handle, mem_addr, zero_bits, mem_size, allocation_type, protect_flag);
}

NTSTATUS robbo_wapi_NtWriteVirtualMemory(HANDLE proc_handle, PVOID mem_addr, PVOID buffer, SIZE_T bytes_num, PSIZE_T bytes_written) {
    RtypeNtWriteVirtualMemory write_mem = robbo_get_function(raw_name_NtWriteVirtualMemory, robbo_addr_ntdll);
    return write_mem(proc_handle, mem_addr, buffer, bytes_num, bytes_written);
}

NTSTATUS robbo_wapi_NtCreateThreadEx(PHANDLE th_handle, ACCESS_MASK accMask, POBJECT_ATTRIBUTES objAttr, HANDLE proc_handle, PVOID start_func, PVOID func_args, ULONG create_flag, SIZE_T zero_bits, SIZE_T stack_size, SIZE_T max_stack_size, PVOID attr_list) {
    RtypeNtCreateThreadEx cr_th = robbo_get_function(raw_name_NtCreateThreadEx, robbo_addr_ntdll);
    return cr_th(th_handle, accMask, objAttr, proc_handle, start_func, func_args, create_flag, zero_bits, stack_size, max_stack_size, attr_list);
}

void robbo_wapi_RtlInitUnicodeString(PUNICODE_STRING dest_str, PCWSTR source_str) {
    RtypeRtlInitUnicodeString uni_str = robbo_get_function(raw_name_RtlInitUnicodeString, robbo_addr_ntdll);
    return uni_str(dest_str, source_str);
}

void robbo_wapi_Sleep(DWORD milisec) {
    RtypeSleep rsleep = robbo_get_function(raw_name_Sleep, robbo_addr_kernel32);
    return rsleep(milisec);
}

NTSTATUS robbo_wapi_NtCreateFile(PHANDLE file_handle, ACCESS_MASK acc_mask, POBJECT_ATTRIBUTES obj_attr, PIO_STATUS_BLOCK io_status_block, PLARGE_INTEGER alloc_size, ULONG file_attr, ULONG share_access, ULONG create_dispotion, ULONG create_options, PVOID ea_buffer, ULONG ea_length) {
    Rtype_NtCreateFile cr_file = robbo_get_function(raw_name_NtCreateFile, robbo_addr_ntdll);
    return cr_file(file_handle, acc_mask, obj_attr, io_status_block, alloc_size, file_attr, share_access, create_dispotion, create_options, ea_buffer, ea_length);
}

NTSTATUS robbo_wapi_NtWriteFile(HANDLE file_handle, HANDLE event_obj, PVOID apc_routine, PVOID apc_context, PIO_STATUS_BLOCK io_status, PVOID buffer, ULONG length, PLARGE_INTEGER byte_offset, PULONG key) {
    Rtype_NtWriteFile wr_file = robbo_get_function(raw_name_NtWriteFile, robbo_addr_ntdll);
    return wr_file(file_handle, event_obj, apc_routine, apc_context, io_status, buffer, length, byte_offset, key);
}

// ---------------------------------- ADDRESS FUNCTIONS -------------------------------------
void* robbo_addr_LdrLoadDll(void) {
    void *lld = robbo_get_function(raw_name_LdrLoadDll, robbo_addr_ntdll);
    return lld;
}

void* robbo_addr_RtlInitUnicodeString(void) {
    void *unSt = robbo_get_function(raw_name_RtlInitUnicodeString, robbo_addr_ntdll);
    return unSt;
}




// ----------------------------------- INIT FUNCTIONS

void robbo_initialize(void) {
    ChipDaleInit();
    robbo_addr_kernel32 = ChipDaleADDR_kernel32();
    robbo_addr_ntdll = ChipDaleADDR_ntdll();
    robbo_f_addr_MultiByteToWideChar = robbo_get_function(raw_name_MultiByteToWideChar, robbo_addr_kernel32);
    printf("\n-------- Robbo Initialize -----------------\n");
}


// ------------------------------- TESTS ---------------------------------------
void robbo_init_test(void) {
    printf("------- ROBBO TEST ---------------\n");
    printf("KERNEL32.DLL Address: 0x%p\n", robbo_addr_kernel32);
    printf("NTDLL.DLL Address: 0x%p\n", robbo_addr_ntdll);
    printf("Function MultiByteToWideChar Address: 0x%p\n", robbo_f_addr_MultiByteToWideChar);
    printf("--------------------------------------------\n");

}