#!name##AsmLib
#!itemType##support
#!info##Static Library NASM Hello World
#!lang##nasm
#!itemTags##WIN##SM
#!fileType##lib
#!hiveType##LIB
#!reqMod##NasmMod
#!modProcess##BUILD_CODE##COMPILE
#!addNameComp##True
#!modCompiler##MinGW_x64_v2





section .data
fmt:    db  "Hello World", 10, 0    ; null-terminated format string

section .text
global mylib_print     ; eksportowana nazwa
extern printf          ; funkcja z C runtime

mylib_print:
    sub     rsp, 40
    lea     rcx, [rel fmt]   ; pierwszy argument printf -> RCX
    xor     eax, eax         ; RAX = 0 (liczba SSE regs used) dla varargs
    call    printf
    add     rsp, 40
    ret