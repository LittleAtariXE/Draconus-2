#!name##Asmek
#!itemType##worm
#!info##NASM worm for testing
#!lang##nasm
#!itemTags##WIN
#!Wprocess##AsmLib
#!Var##first##ala##variable for test##str
#!wormCompiler##MinGW_x64_v2
#!reqMod##KupaDLL


extern ExitProcess
extern printf
extern Hello

section .data
    my_text: db "{{first}}", 10, 0

section .text
    global main

main:
    sub rsp, 40
    mov rcx, my_text
    call printf
    call Hello
    mov rcx, 0
    call ExitProcess