#!name##Asmek
#!itemType##worm
#!info##Two compilators test
#!lang##nasm
#!itemTags##WIN
#!Wprocess##BasicAsm
#!Var##first##ala##variable for test##str
#!wormCompiler##MinGW_x64_v2
#!aaareqMod##LibComp


extern ExitProcess
extern printf


section .data
    my_text: db "{{first}}", 10, 0

section .text
    global main

main:
    sub rsp, 40
    mov rcx, my_text
    call printf
    mov rcx, 0
    call ExitProcess