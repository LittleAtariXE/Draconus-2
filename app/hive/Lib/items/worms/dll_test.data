#!info##Test worm dll
#!fileType##dll
#!lang##c
#!Wprocess##BasicProc
#!wormCompiler##Basic-C
#!dllDef##hello##ADD

#include <stdio.h>
#include <windows.h>

BOOL DllMain(HMODULE hModule, DWORD reason, LPVOID reserved) {
    switch (reason) {
        case DLL_PROCESS_ATTACH:
            printf("DLL zaladowane\n");
            break;
        case DLL_THREAD_ATTACH:
            break;
        case DLL_THREAD_DETACH:
            break;
        case DLL_PROCESS_DETACH:
            printf("DLL odlaczone\n");
            break;
    }
    return TRUE;
}



__declspec(dllexport) void hello(void) {
    printf("Hello World from DLL\n");
}

__declspec(dllexport) int ADD(int a, int b) {
    return a + b;
}
