#include "drMario_cmd.h"
#include <stdio.h>

#include <dirent.h>

void HelloWorld(void) {
    robbo_initialize();
    robbo_locust_initialize();
    rtcp_initialize();
    pDR_MARIO_COMMANDER_CONSOLE mario1 = drMario_build_commander(0, 4444);
    mario1->start(mario1);
    robbo_wapi_WaitForSingleObject(mario1->cmd_handle, INFINITE);
    mario1->stop(mario1);
}

