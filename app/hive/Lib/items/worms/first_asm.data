#!name##AsmTest
#!itemType##worm
#!info##first asm worm for test
#!lang##nasm
#!itemTags##WIN
#!Wprocess##BasicAsm
#!Var##first##ala##variable for test##str
#!aareqMod##AsmLib
#!typeAccept##LIB
#!wormCompiler##MinGW_x64_Nasm
#!inFile##FirstIn##myLib.asm
#!inFile##ZweiIn##secondLib.asm

extern ExitProcess
extern printf

%include "./myLib.asm"
%include "./secondLib.asm"

section .data
    my_text: db "{{first}}", 10, 0

section .text
    global main

main:
    sub rsp, 40
    mov rcx, my_text
    call printf
    mov rcx, 0
    call ExitProcess