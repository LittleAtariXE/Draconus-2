#!name##PayTest
#!itemType##worm
#!info##Worm with payloads
#!lang##nasm
#!itemTags##WIN
#!Wprocess##BasicPay
#!wormCompiler##Basic-Nasm
#!payloadSpace##pejlold##My first evil payload


extern ExitProcess
extern printf


section .data
    my_text: db "{{pejlold}}", 10, 0

section .text
    global main

main:
    sub rsp, 40
    mov rcx, my_text
    call printf
    mov rcx, 0
    call ExitProcess