#!name##Dynamo
#!itemType##worm
#!fileType##dll
#!info##Worm as DLL
#!lang##nasm
#!Wprocess##BasicAsm
#!wormCompiler##MinGW_x64_v2
#!Var##k_text##Siemano##Text to print##str





global DllMain
global Hello

extern printf

section .data
    my_text: db "{{k_text}}", 10, 0

section .text

DllMain:
    mov rax, 1
    ret

Hello:
    push rbp
    mov rbp, rsp
    
    sub rsp, 40
    mov rcx, my_text
    call printf
    add rsp, 40
    
    pop rbp
    ret